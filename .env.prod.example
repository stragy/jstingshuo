# ===== 生产环境配置 =====
# 复制此文件为 .env.prod 并填写真实值
# cp .env.prod.example .env.prod

# ===== 数据库 =====
DB_NAME=hui_listening
DB_USER=hui_app
DB_PASSWORD=请替换为强密码

# ===== JWT =====
JWT_SECRET=请替换为32位以上的随机字符串

# ===== MinIO 对象存储 =====
OSS_ACCESS_KEY=请替换为强密码
OSS_SECRET_KEY=请替换为强密码
OSS_BUCKET=audio-uploads

# ===== 驰声 Chivox =====
# 留空则使用 Mock 评测；填入真实凭据则走驰声 API
CHIVOX_APP_ID=
CHIVOX_APP_SECRET=
CHIVOX_ENDPOINT=https://api.chivox.com/cloud/eval/v2
