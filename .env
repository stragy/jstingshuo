# ===== BFF (api-bff) =====
PORT=3000
JWT_SECRET=dev-secret-change-me

# ===== OSS（录音文件存储） =====
# localhost 或留空 → 本地落盘模式（开发）
# 远端地址 → 启用 OSS 上传（生产）
OSS_ENDPOINT=http://localhost:9000
OSS_BUCKET=audio-uploads

# ===== PostgreSQL (BFF) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hui_listening?schema=public

# ===== 驰声 Chivox =====
# 留空则自动使用 Mock 评测（返回确定性假分数）
# 填入真实 ID/Secret 后走 AI Service → 驰声 API 真实评测
CHIVOX_APP_ID=
CHIVOX_APP_SECRET=
CHIVOX_ENDPOINT=https://api.chivox.com/cloud/eval/v2

# ===== AI Service (FastAPI) =====
AI_SVC_URL=http://localhost:8000/api

# ===== 前端 Vite =====
# true → 走真实 BFF 代理（需要 BFF 已启动）
# false → 走 Vite Mock 插件（BFF 无需启动）
VITE_USE_REAL_BFF=false
